# ================================================================
# Telegram Auto-Uploader & Channel Aggregator Bot Configuration
# ================================================================

# --- Core Telegram API Credentials ---
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# --- Admin & Permissions ---
# Telegram User ID of the primary bot owner
OWNER_ID=123456789
# Comma-separated list of initial admin IDs (optional)
ADMIN_IDS=123456789,987654321

# --- MongoDB Multi-Cluster Redundancy ---
# Primary MongoDB Connection URI
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/?retryWrites=true&w=majority
# Additional fallback MongoDB URIs separated by comma for multi-cluster redundancy
MONGO_URIS=mongodb+srv://username:password@cluster1.mongodb.net/?retryWrites=true&w=majority
# Database name
DATABASE_NAME=TelegramAutoUploaderBot

# --- External File Storage Bot Integration ---
# Username of the external file storage bot (without @)
EXTERNAL_STORAGE_BOT=ExternalFileStorageBot
# Channel ID of the external storage database channel (with -100 prefix)
EXTERNAL_DB_CHANNEL_ID=-1001234567890
# Format string for start parameter: options include 'file_{msg_id}', '{msg_id}', 'get_{msg_id}'
STORAGE_START_PARAM_FORMAT=file_{msg_id}

# --- Channel Defaults (Can also be configured via Admin Panel) ---
# Main target channel ID where aggregated posts are published
MAIN_CHANNEL_ID=
# Update notification channel ID where update posts & weekly polls are sent
UPDATE_CHANNEL_ID=
# Optional admin log channel ID for monitoring errors and activities
LOG_CHANNEL_ID=

# --- FFmpeg Watermark Configuration ---
# Toggle watermarking on/off globally (true / false)
ENABLE_WATERMARK=false
# Watermark overlay text
WATERMARK_TEXT=@MyTelegramChannel
# Watermark position: top-left | top-right | bottom-left | bottom-right | center
WATERMARK_POSITION=bottom-right
# Watermark font size (integer)
WATERMARK_FONT_SIZE=28
# Watermark font color (hex or standard color name)
WATERMARK_FONT_COLOR=white

# --- Automated Weekly Poll Configuration ---
# Timezone (Default: Asia/Kolkata for IST)
WEEKLY_POLL_TIMEZONE=Asia/Kolkata
# Scheduled hour on Sunday (22 = 10:00 PM IST)
WEEKLY_POLL_HOUR=22
WEEKLY_POLL_MINUTE=0
